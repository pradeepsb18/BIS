
import random

# Number of roads
roads = 4

# Number of vehicles waiting on each road
vehicles = [50, 20, 40, 10]

# Total green signal time in seconds
total_time = 120

# Generate a random timing plan
def create_solution():
    times = [random.randint(10, 50) for _ in range(roads)]
    total = sum(times)

    # Adjust timings to make total time 120 seconds
    times = [int(t * total_time / total) for t in times]
    times[0] += total_time - sum(times)

    return times

# Calculate fitness
def fitness(times):
    waiting_time = 0

    for i in range(roads):
        waiting_time += vehicles[i] * (total_time - times[i])

    return 1 / (1 + waiting_time)

# Genetic Algorithm
population = [create_solution() for _ in range(20)]

for generation in range(100):

    # Select the best solutions
    population.sort(key=fitness, reverse=True)
    parents = population[:10]

    new_population = parents.copy()

    # Crossover and mutation
    while len(new_population) < 20:
        p1, p2 = random.sample(parents, 2)

        child = [
            (p1[i] + p2[i]) // 2
            for i in range(roads)
        ]

        # Mutation
        index = random.randint(0, roads - 1)
        child[index] += random.randint(-3, 3)

        # Keep timings within limits
        child = [max(10, t) for t in child]

        # Normalize timings to total 120 seconds
        total = sum(child)
        child = [int(t * total_time / total) for t in child]
        child[0] += total_time - sum(child)

        new_population.append(child)

# Display the best solution
best = max(population, key=fitness)

print("Optimized Traffic Signal Timings:")
for i in range(roads):
    print("Road", i + 1, ":", best[i], "seconds")

print("Fitness:", fitness(best))
